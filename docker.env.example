# Local Docker-only MongoDB credentials.
# Copy this file to the repository root as .env, then replace the password
# with a unique random alphanumeric value of at least 32 characters.
# The root .env file is ignored by Git and must never be committed.
MONGO_INITDB_ROOT_USERNAME=securegate
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_32_CHARACTER_ALPHANUMERIC_PASSWORD
