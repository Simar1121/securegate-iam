{
  "name": "securegate-server",
  "version": "1.0.0",
  "description": "SecureGate - Enterprise Identity & Access Management Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:risk && npm run test:abac && node testSecurityAudit.js",
    "test:risk": "node --test test/riskEngine.test.js test/riskAssessmentService.test.js",
    "test:abac": "node --test test/abacPolicyEngine.test.js test/abacPolicyValidation.test.js test/deviceAbacMiddleware.test.js test/deviceController.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^10.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}