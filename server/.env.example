PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/securegate_org_db
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/securegate_test_db
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Set only when running behind a trusted reverse proxy; use the exact hop count.
TRUST_PROXY_HOPS=0

# Gmail SMTP (use a Google App Password; never your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-securegate-sender@gmail.com
SMTP_APP_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
EMAIL_FROM=SecureGate IAM <your-securegate-sender@gmail.com>
FRONTEND_URL=http://localhost:5173
